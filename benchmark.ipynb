def builtin_sort_select(arr, k):
    arr.sort()
    return arr[k - 1]

def merge_sort(arr):
    if len(arr) <= 1:
        return arr
    mid = len(arr) // 2
    left = merge_sort(arr[:mid])
    right = merge_sort(arr[mid:])
    merged = []
    i = j = 0
    while i < len(left) and j < len(right):
        if left[i] <= right[j]:
            merged.append(left[i])
            i += 1
        else:
            merged.append(right[j])
            j += 1
    merged.extend(left[i:])
    merged.extend(right[j:])
    return merged

def merge_sort_select(arr, k):
    return merge_sort(arr)[k - 1]

def quickselect_call(arr, k):
    return select(arr, 0, len(arr) - 1, k)