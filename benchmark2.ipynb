import math
import platform
import statistics
import sys
from time import perf_counter_ns
from IPython.display import Markdown, display

SIZES = [1000, 5000, 10000, 50000, 100000, 250000, 500000]
TRIALS = 15
DATA_SEED = 4107
PIVOT_SEED = 4108
data_rng = random.Random(DATA_SEED)
random.seed(PIVOT_SEED)
methods = [
    ('Quickselect', quickselect_call),
    ('Built-in sort', builtin_sort_select),
    ('Python merge sort', merge_sort_select),
]

print('Python:', sys.version.split()[0])
print('Platform:', platform.platform())
print('Processor:', platform.processor() or 'not reported')
print('Data seed:', DATA_SEED, '| Pivot seed:', PIVOT_SEED)
print('Trials per size:', TRIALS, '| k = (n + 1) // 2')
print('Only algorithm execution and result lookup are timed.')

warmup = list(range(2000))
data_rng.shuffle(warmup)
for _, fn in methods:
    for _ in range(3):
        assert fn(warmup.copy(), 1000) == 999

observations = []
summary = []
for n in SIZES:
    k = (n + 1) // 2
    times = {name: [] for name, _ in methods}
    for trial in range(TRIALS):
        base = list(range(n))
        data_rng.shuffle(base)
        shift = trial % len(methods)
        order = methods[shift:] + methods[:shift]
        for name, fn in order:
            work = base.copy()
            start = perf_counter_ns()
            answer = fn(work, k)
            elapsed_ms = (perf_counter_ns() - start) / 1_000_000
            assert answer == k - 1, (n, trial, name, answer)
            times[name].append(elapsed_ms)
            observations.append({'n': n, 'trial': trial + 1,
                                 'method': name, 'elapsed_ms': elapsed_ms})
    row = {'n': n}
    for name, _ in methods:
        row[name] = statistics.median(times[name])
    summary.append(row)

table = '| n | Quickselect (ms) | Built-in sort (ms) | Python merge sort (ms) |\n'
table += '|---:|---:|---:|---:|\n'
for row in summary:
    table += f"| {row['n']:,} | {row['Quickselect']:.3f} | {row['Built-in sort']:.3f} | {row['Python merge sort']:.3f} |\n"
display(Markdown(table))
print('Every timed result matched the expected lower median.')